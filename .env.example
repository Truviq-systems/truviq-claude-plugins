# Names of the keys TruViq Guard reads. Put your values in ~/.truviq/guard.env, never in this repository:
#   truviq setup --keys            (asks for each one, hidden)
#   truviq setup --import-env .env (copies them from a .env like this one)
# The guard never reads secrets from the plugin folder.

# Groq first, Gemini fallback: prompt-injection classifier and the end-of-turn code logic review.
# TRUVIQ_LLM=off keeps everything local.
GROQ_API_KEY=
GROQ_API_KEYS_POOL=
GOOGLE_API_KEY=
TRUVIQ_LLM=on

# Email alerts via Resend
RESEND_API_KEY=
TRUVIQ_ALERT_TO=
TRUVIQ_ALERT_FROM=TruViq Guard <onboarding@resend.dev>

# Central dashboard (Supabase). Every machine: URL + ANON key. Only the dashboard machine: SERVICE ROLE key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
